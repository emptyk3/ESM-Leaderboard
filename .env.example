# Pooled Neon connection used by the running application (host typically contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@PROJECT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Direct Neon connection used only by Prisma CLI and migrations (host without -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@PROJECT.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Used once by `npm run admin:bootstrap`. Never commit real values.
INITIAL_ADMIN_NAME=""
INITIAL_ADMIN_ALIAS=""
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
