# Pooled Neon connection used by the running application (host typically contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@PROJECT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Direct Neon connection used only by Prisma CLI and migrations (host without -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@PROJECT.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Optional local/canonical origin for QR links. Vercel provides its stable production origin automatically.
APP_URL="http://localhost:3000"

# Optional dedicated value (at least 32 random characters) for HMAC request fingerprints.
# If omitted, the already secret DATABASE_URL is used as a safe server-only fallback.
RATE_LIMIT_PEPPER="replace-with-a-random-secret-of-at-least-32-characters"

# Used once by `npm run admin:bootstrap`. Never commit real values.
INITIAL_ADMIN_NAME=""
INITIAL_ADMIN_ALIAS=""
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
